<?xml version="1.0" encoding="utf-8"?>
<!-- System splash icon: the same green tile + cart the animated Compose splash starts from
     (128dp tile, 84dp cart). An icon without a background is drawn in a 288dp box, so the
     tile is centred in 288 units to land at exactly 128dp on screen. The check mark is left
     out: the animated splash draws it in. -->
