rules_version = '2';

// SmartCart: each user can only read/write their own profile and bills.
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile. isPro is the admin's switch (set it in the Firebase console):
    // the app may create the profile only with isPro = false and can never change isPro or userId.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.isPro == false;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }
    match /users/{userId}/bills/{billId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }
    // Shared price board: one document per bill item (no name/email/address), for
    // cheaper-price alerts and the Smart Store Plan. Signed-in users can read;
    // each user can only write/delete their own documents.
    match /prices/{priceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
