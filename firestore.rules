rules_version = '2';

// SmartCart: each user can only read/write their own profile and bills.
service cloud.firestore {
  match /databases/{database}/documents {
    // The admin panel account (Google sign-in, so the email is verified). Must match AdminRepository.ADMIN_EMAIL.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fawwadshamim.fs@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // User profile. isPro is the admin's switch (set it in the Firebase console):
    // the app may create the profile only with isPro = false and can never change isPro or userId.
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      // Admin panel: may only flip a user's Pro switch.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPro', 'proUpdatedAt', 'proUpdatedBy']);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.isPro == false;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.get('isPro', false) == resource.data.get('isPro', false)
        && (!('userId' in resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }
    match /users/{userId}/bills/{billId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }
    // Shared price board: one document per bill item (no name/email/address), for
    // cheaper-price alerts and the Smart Store Plan. Signed-in users can read;
    // each user can only write/delete their own documents.
    match /prices/{priceId} {
      // Guests are signed in anonymously only for the usage log: they don't get the price board.
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.price is number
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // App usage log for the admin dashboard (SessionTracker): one document per phone per day,
    // id "<phone id>_<yyyyMMdd>". Every phone (guests sign in anonymously) writes only its own
    // phone's document; after a reinstall the phone has a new sign-in but the same phone id.
    // Only the admin reads them.
    match /app_sessions/{docId} {
      allow create: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && docId.matches(request.resource.data.deviceId + '_[0-9]{8}');
      allow update: if request.auth != null
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.deviceId == resource.data.deviceId;
      allow read, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
